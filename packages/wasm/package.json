{
  "name": "@element-plus/wasm",
  "version": "1.0.0",
  "type": "module",
  "description": "WebAssembly acceleration layer for FsusUI (C++23 / Emscripten)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@element-plus/utils": "workspace:*"
  },
  "scripts": {
    "build:wasm": "node ../../scripts/with-node-heap.mjs bash ./build.sh",
    "build": "node ../../scripts/with-node-heap.mjs unbuild",
    "dev": "pnpm run stub",
    "stub": "node ../../scripts/with-node-heap.mjs unbuild --stub",
    "clean": "rimraf dist build"
  },
  "devDependencies": {
    "unbuild": "^3.6.1",
    "rimraf": "^6.1.3"
  }
}
