{
  "name": "@element-plus/icons-vue",
  "version": "2.3.2",
  "description": "Vue components of Element Plus Icons collection.",
  "type": "module",
  "keywords": [
    "icon",
    "svg",
    "vue",
    "element-plus"
  ],
  "license": "MIT",
  "homepage": "https://element-plus.org/",
  "bugs": {
    "url": "https://github.com/element-plus/element-plus-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-plus/element-plus-icons.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/types/global.d.ts",
      "require": "./dist/global.cjs",
      "import": "./dist/global.js"
    },
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./*",
        "./dist/types/*"
      ]
    }
  },
  "sideEffects": false,
  "unpkg": "dist/index.iife.min.js",
  "jsdelivr": "dist/index.iife.min.js",
  "scripts": {
    "build": "node ../../scripts/with-node-heap.mjs pnpm run build:generate && node ../../scripts/with-node-heap.mjs run-p build:build build:types",
    "build:generate": "node ../../scripts/with-node-heap.mjs tsx build/generate.ts",
    "build:build": "NODE_ENV=production node ../../scripts/with-node-heap.mjs tsx build/build.ts",
    "build:types": "node ../../scripts/with-node-heap.mjs vue-tsc --declaration --emitDeclarationOnly"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@element-plus/icons-svg": "workspace:*",
    "@types/node": "*",
    "camelcase": "^9.0.0",
    "consola": "^3.4.2",
    "esbuild": "^0.28.0",
    "esbuild-plugin-globals": "^0.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "tinyglobby": "^0.2.15",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "unplugin-vue": "^7.1.0",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  }
}
