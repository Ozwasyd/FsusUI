{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node ./scripts/with-node-heap.mjs vitest",
    "ensure:icons": "node ./scripts/with-node-heap.mjs node ./scripts/ensure-icons-artifacts.mjs",
    "ensure:wasm": "node ./scripts/with-node-heap.mjs node ./scripts/ensure-wasm-artifacts.mjs",
    "prepare:test-artifacts": "node ./scripts/with-node-heap.mjs run-p ensure:icons ensure:wasm",
    "test:run": "pnpm run test:unit",
    "test:unit": "node ./scripts/with-node-heap.mjs run-s prepare:test-artifacts _test:unit:parallel",
    "test:unit:components": "node ./scripts/with-node-heap.mjs run-s prepare:test-artifacts _test:unit:components",
    "test:unit:theme": "node ./scripts/with-node-heap.mjs vitest run packages/theme-chalk",
    "test:unit:core": "node ./scripts/with-node-heap.mjs run-s prepare:test-artifacts _test:unit:core",
    "test:unit:boundary": "node ./scripts/with-node-heap.mjs vitest run tests/boundary",
    "test:coverage": "node ./scripts/with-node-heap.mjs run-s prepare:test-artifacts _test:coverage",
    "test:consumer-install": "node ./scripts/with-node-heap.mjs node ./scripts/test-consumer-install.mjs",
    "_test:run": "node ./scripts/with-node-heap.mjs vitest run",
    "_test:unit:parallel": "node ./scripts/with-node-heap.mjs run-p _test:unit:components _test:unit:theme _test:unit:core _test:unit:boundary",
    "_test:unit:components": "node ./scripts/with-node-heap.mjs vitest run packages/components",
    "_test:unit:theme": "node ./scripts/with-node-heap.mjs vitest run packages/theme-chalk",
    "_test:unit:core": "node ./scripts/with-node-heap.mjs vitest run packages/hooks packages/directives packages/utils packages/wasm",
    "_test:unit:boundary": "node ./scripts/with-node-heap.mjs vitest run tests/boundary",
    "_test:coverage": "node ./scripts/with-node-heap.mjs vitest run --coverage",
    "test:visual": "node ./scripts/with-node-heap.mjs run-s prepare:test-artifacts _test:visual:parallel",
    "_test:visual:parallel": "node ./scripts/with-node-heap.mjs run-p test:visual:preview test:visual:dev",
    "test:visual:preview": "node ./scripts/with-node-heap.mjs playwright test --config=playwright.config.ts",
    "test:visual:dev": "node ./scripts/with-node-heap.mjs playwright test --config=playwright.dev.config.ts",
    "test:visual:reuse": "node ./scripts/with-node-heap.mjs playwright test --config=playwright.reuse.config.ts",
    "test:dom-layout": "node ./scripts/with-node-heap.mjs playwright test --config=playwright.dom-layout.config.ts",
    "audit:visual-boundaries": "node ./scripts/with-node-heap.mjs playwright test --config=playwright.boundary-audit.config.ts",
    "audit:templates": "node ./scripts/with-node-heap.mjs node ./scripts/audit-template-dom.mjs",
    "perf:wasm": "node ./scripts/with-node-heap.mjs run-s ensure:wasm _perf:wasm",
    "_perf:wasm": "node ./scripts/with-node-heap.mjs node ./scripts/wasm-performance-smoke.mjs",
    "check:markdown-wasm": "node ./scripts/with-node-heap.mjs node ./tests/wasm/check-markdown-wasm.mjs",
    "check:markdown-wasm-runtime": "node ./scripts/with-node-heap.mjs node ./tests/wasm/check-markdown-wasm-runtime.mjs",
    "check:markdown-no-js-path": "node ./scripts/with-node-heap.mjs node ./tests/wasm/check-markdown-no-js-path.mjs",
    "check:markdown-extreme": "node ./scripts/with-node-heap.mjs node ./tests/wasm/check-markdown-extreme.mjs",
    "check:result-boundaries": "node ./scripts/with-node-heap.mjs node ./scripts/check-result-boundaries.mjs",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean",
    "clean:dist": "rimraf dist",
    "clean:package-build": "rimraf dist/element-plus dist/types packages/theme-chalk/dist",
    "build": "node ./scripts/with-node-heap.mjs pnpm run -C internal/build start",
    "build:demo": "node ./scripts/with-node-heap.mjs pnpm run ensure:wasm && node ./scripts/with-node-heap.mjs pnpm run -C packages/demo-app build",
    "build:npm-package": "node ./scripts/with-node-heap.mjs pnpm run build && node ./scripts/with-node-heap.mjs node ./scripts/prepare-npm-package.mjs --strict",
    "build:theme": "node ./scripts/with-node-heap.mjs pnpm run -C packages/theme-chalk build",
    "build:wasm": "node ./scripts/with-node-heap.mjs node ./scripts/ensure-wasm-artifacts.mjs --force",
    "_build:wasm:artifacts": "node ./scripts/with-node-heap.mjs pnpm run -C packages/wasm build:wasm && node ./scripts/with-node-heap.mjs pnpm run -C packages/wasm build",
    "format": "prettier --write --cache .",
    "lint": "node ./scripts/with-node-heap.mjs eslint . --max-warnings 0 --cache",
    "lint:fix": "pnpm run lint --fix",
    "check:consumer-contract": "node ./scripts/with-node-heap.mjs node ./scripts/check-consumer-contract.mjs",
    "check:npm-dist-tag": "node ./scripts/with-node-heap.mjs node ./scripts/check-npm-dist-tag.mjs",
    "check:anti-ai-visual": "node ./scripts/with-node-heap.mjs node ./scripts/check-anti-ai-visual.mjs",
    "check:motion-adoption": "node ./scripts/with-node-heap.mjs node ./scripts/check-motion-adoption.mjs packages/motion/__tests__/fixtures/fsusblog-motion-adoption.json",
    "check:ux-semantics": "node ./scripts/with-node-heap.mjs node ./scripts/check-ux-semantics.mjs",
    "check:design-source-drift": "node ./scripts/with-node-heap.mjs node ./scripts/check-design-source-drift.mjs",
    "check:focus-ring-contract": "node ./scripts/with-node-heap.mjs node ./scripts/check-focus-ring-contract.mjs",
    "check:form-state-contract": "node ./scripts/with-node-heap.mjs node ./scripts/check-form-state-contract.mjs",
    "check:upload-focus-contract": "node ./scripts/with-node-heap.mjs node ./scripts/check-upload-focus-contract.mjs",
    "tokens:generate": "node ./scripts/with-node-heap.mjs node ./scripts/token-pipeline.mjs generate",
    "tokens:check": "node ./scripts/with-node-heap.mjs node ./scripts/token-pipeline.mjs check",
    "tokens:lint": "node ./scripts/with-node-heap.mjs node ./scripts/token-pipeline.mjs lint",
    "icons:generate": "node ./scripts/with-node-heap.mjs node ./scripts/icon-pipeline.mjs generate",
    "icons:check": "node ./scripts/with-node-heap.mjs node ./scripts/icon-pipeline.mjs check",
    "icons:lint": "node ./scripts/with-node-heap.mjs node ./scripts/icon-pipeline.mjs lint",
    "conformance:tokens": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs tokens",
    "conformance:contracts": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs contracts",
    "conformance:interactions": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs interactions",
    "conformance:visual": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs visual",
    "conformance:a11y": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs a11y",
    "conformance:platform-overrides": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs platform-overrides",
    "conformance": "node ./scripts/with-node-heap.mjs node ./scripts/check-conformance.mjs all",
    "governance:check": "node ./scripts/with-node-heap.mjs node ./scripts/check-cross-platform-governance.mjs",
    "dotnet:restore": "dotnet restore dotnet/FsusUI.Avalonia.slnx",
    "dotnet:build": "dotnet build dotnet/FsusUI.Avalonia.slnx --no-restore --configuration Release",
    "dotnet:test": "dotnet test dotnet/FsusUI.Avalonia.slnx --no-build --configuration Release",
    "dotnet:smoke": "dotnet run --project dotnet/FsusUI.Avalonia.Demo/FsusUI.Avalonia.Demo.csproj -- --smoke",
    "dotnet:pack": "dotnet pack dotnet/FsusUI.Avalonia.slnx --no-build --configuration Release -o dotnet/artifacts/nuget",
    "dotnet:metadata": "node ./scripts/with-node-heap.mjs node ./scripts/check-nuget-metadata.mjs",
    "dotnet:package-smoke": "node ./scripts/with-node-heap.mjs node ./scripts/check-nuget-package-smoke.mjs",
    "dotnet:verify": "node ./scripts/with-node-heap.mjs run-s dotnet:restore dotnet:build dotnet:test dotnet:smoke dotnet:pack dotnet:metadata dotnet:package-smoke icons:check tokens:check conformance governance:check",
    "verify": "node ./scripts/with-node-heap.mjs run-s prepare:test-artifacts _verify:parallel build:demo",
    "_verify:parallel": "node ./scripts/with-node-heap.mjs run-p lint typecheck tokens:check tokens:lint icons:check icons:lint conformance governance:check check:consumer-contract check:result-boundaries check:anti-ai-visual check:ux-semantics check:design-source-drift check:focus-ring-contract check:form-state-contract check:upload-focus-contract _test:unit:parallel build",
    "verify:strict": "node ./scripts/with-node-heap.mjs run-s verify check:npm-dist-tag build:npm-package test:consumer-install",
    "verify:release": "node ./scripts/with-node-heap.mjs run-s verify:strict",
    "changeset": "node ./scripts/with-node-heap.mjs changeset",
    "version-packages": "node ./scripts/with-node-heap.mjs changeset version",
    "typecheck": "node ./scripts/with-node-heap.mjs run-p typecheck:web typecheck:node typecheck:vite-config typecheck:vitest",
    "typecheck:web": "node ./scripts/with-node-heap.mjs vue-tsc -p tsconfig.web.json --composite false --noEmit",
    "typecheck:node": "node ./scripts/with-node-heap.mjs tsc -p tsconfig.node.json --noEmit",
    "typecheck:vite-config": "node ./scripts/with-node-heap.mjs vue-tsc -p tsconfig.vite-config.json --composite false --noEmit",
    "typecheck:vitest": "node ./scripts/with-node-heap.mjs vue-tsc -p tsconfig.vitest.json --composite false --noEmit",
    "stub": "node ./scripts/with-node-heap.mjs pnpm run -r --parallel stub",
    "prepare": "husky",
    "postinstall": "pnpm stub"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@element-plus/components": "workspace:*",
    "@element-plus/constants": "workspace:*",
    "@element-plus/directives": "workspace:*",
    "@element-plus/hooks": "workspace:*",
    "@element-plus/icons-vue": "workspace:*",
    "@element-plus/locale": "workspace:*",
    "@element-plus/test-utils": "workspace:*",
    "@element-plus/theme-chalk": "workspace:*",
    "@element-plus/utils": "workspace:*",
    "@element-plus/wasm": "workspace:*",
    "@floating-ui/dom": "^1.7.6",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@types/lodash-es": "^4.17.6",
    "async-validator": "^4.2.5",
    "dayjs": "^1.11.20",
    "escape-html": "^1.0.3",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.3",
    "memoize-one": "^6.0.0",
    "motion-dom": "^12.40.0",
    "normalize-wheel-es": "^1.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@element-plus/build": "workspace:^0.0.1",
    "@element-plus/build-utils": "workspace:^0.0.1",
    "@element-plus/eslint-config": "workspace:*",
    "@element-plus/icons-svg": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@pnpm/find-workspace-packages": "^4.0.16",
    "@pnpm/logger": "^4.0.0",
    "@pnpm/types": "^8.4.0",
    "@types/fs-extra": "^11.0.4",
    "@types/gulp": "^4.0.17",
    "@types/jsdom": "^21.1.7",
    "@types/node": "*",
    "@types/sass": "^1.45.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.0",
    "csstype": "^3.1.4",
    "eslint": "^10.2.0",
    "expect-type": "^1.2.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^15.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "type-fest": "^4.41.0",
    "typescript": "^6.0.2",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "vue": "^3.5.32",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">= 22",
    "pnpm": ">= 10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vite",
        "react",
        "react-dom"
      ]
    }
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx}": "eslint --fix --no-warn-ignored"
  }
}
