  "directives": {
    "vClickOutside": "web-only",
    "vFsusInfiniteScroll": "native-adapter",
    "vFsusLoading": "platform-override"
  },
  "services": {
    "FsusLoadingService": "platform-override",
    "FsusMessage": "platform-override",
    "FsusMessageBox": "platform-override",
