    "display": "portable",
    "divider": "portable",
    "drawer": "platform-override",
    "dropdown": "native-adapter",
    "empty-state": "portable",
    "form": "native-adapter",
    "icon": "portable",
    "image": "native-adapter",
    "input": "native-adapter",
    "input-number": "native-adapter",
    "layout": "portable",
    "link": "portable",
    "loading": "platform-override",
    "markdown-editor": "native-adapter",
    "markdown-renderer": "native-adapter",
    "message": "platform-override",
    "message-box": "platform-override",
    "navigation": "native-adapter",
    "notification": "platform-override",
    "pagination": "native-adapter",
    "perception-challenge": "native-adapter",
    "popconfirm": "platform-override",
    "popover": "platform-override",
    "primitives": "portable",
    "progress": "portable",
    "radio": "native-adapter",
    "rate": "native-adapter",
    "result": "portable",
    "scrollbar": "native-adapter",
    "select": "native-adapter",
    "skeleton": "portable",
    "slider": "native-adapter",
    "space": "portable",
    "switch": "native-adapter",
    "table": "native-adapter",
    "tag": "portable",
    "text": "portable",
    "theme-mode-toggle": "platform-override",
    "time-picker": "native-adapter",
    "time-select": "native-adapter",
    "tooltip": "platform-override",
    "transfer": "native-adapter",
    "tree": "native-adapter",
    "upload": "native-adapter",
    "virtual-list": "native-adapter"
