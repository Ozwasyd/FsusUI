    "./locale": "portable",
    "./markdown": "native-adapter",
    "./motion": "portable",
    "./package.json": "portable",
    "./perception-challenge": "native-adapter",
    "./render-pipeline": "portable",
    "./result": "portable",
    "./styles/*.css": "portable",
    "./styles/fsus.css": "portable",
    "./styles/markdown.css": "native-adapter",
    "./theme": "portable",
    "./wasm": "web-only"
  }
