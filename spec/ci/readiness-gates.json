    ]
  },
  "execution": {
    "main": {
      "aggregator": "stable-readiness",
      "realRenderProfile": "quick",
      "visualProfile": "full"
    },
    "nightly": {
      "aggregator": "nightly-readiness",
      "realRenderProfile": "full",
