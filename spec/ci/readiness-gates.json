    "build-package": { "cardinality": "single" },
    "consumer-install": { "cardinality": "single" },
    "build-demo": { "cardinality": "single" },
    "visual": { "cardinality": "single" },
    "real-render-performance": { "cardinality": "single" }
  },
  "artifactBindings": [
    {
      "name": "npm-candidate",
      "producer": "build-package",
      "consumer": "consumer-install"
    }
  ]
}
