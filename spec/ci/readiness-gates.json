{
  "schemaVersion": 1,
  "playwright": {
    "owners": "spec/ci/playwright-owners.json",
    "suites": "spec/ci/playwright-suites.json",
    "ownerIds": []
  },
  "profiles": {
    "main": [
      "static-quality",
      "typecheck",
      "unit",
      "markdown-xss",
      "build-package",
      "consumer-verify",
      "build-demo",
      "visual",
      "dotnet-platform",
      "dotnet-package"
    ],
    "nightly": [
      "static-quality",
      "typecheck",
      "unit",
      "markdown-xss",
      "build-package",
      "consumer-verify",
      "build-demo",
      "visual",
      "dotnet-platform",
      "dotnet-package"
    ],
    "release": [
      "static-quality",
      "typecheck",
      "unit",
      "markdown-xss",
      "build-package",
      "consumer-verify",
      "build-demo",
      "visual",
      "dotnet-platform",
      "dotnet-package"
    ]
  },
  "execution": {
    "main": {
      "aggregator": "stable-readiness",
      "visualProfile": "full"
    },
    "nightly": {
      "aggregator": "nightly-readiness",
      "visualProfile": "full"
    },
    "release": {
      "aggregator": "release-readiness",
      "visualProfile": "evidence",
      "identityBinding": "commit-tag-package"
    }
  },
  "owners": {
    "static-quality": { "cardinality": "single" },
    "typecheck": { "cardinality": "single" },
    "unit": { "cardinality": "single" },
    "markdown-xss": { "cardinality": "single" },
    "build-package": { "cardinality": "single" },
    "consumer-verify": { "cardinality": "single" },
    "build-demo": { "cardinality": "single" },
    "visual": { "cardinality": "single" },
    "dotnet-platform": {
      "cardinality": "matrix",
      "dimension": "platform",
      "values": ["linux", "windows", "macos"]
    },
    "dotnet-package": { "cardinality": "single" }
  },
  "artifactBindings": [
    {
      "name": "npm-candidate",
      "producer": "build-package",
      "consumer": "consumer-verify"
    }
  ]
}
