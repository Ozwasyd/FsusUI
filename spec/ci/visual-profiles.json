    "vue/packages/core/**",
    "vue/packages/theme/src/**",
    "vue/packages/motion/**",
    "vue/packages/demo-app/src/style.css",
    "vue/packages/demo-app/src/ui-audit-manifest.ts",
    "vue/playwright*.ts",
    "vue/tests/visual/**",
    "scripts/check-visual-orchestration-policy.mjs",
    "scripts/prepare-visual-runtime.mjs",
    "scripts/run-visual-tests.mjs",
    "scripts/serve-visual-runtime.mjs",
    "scripts/test-parallelism.ts",
    "scripts/visual-*.mjs",
    "scripts/visual-*.cjs",
    "spec/ci/visual-profiles.json",
    "tests/fixtures/visual-*/**",
    "tests/visual-*.test.mjs",
    "tests/visual-runtime/**"
