{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsusui.dev/schema/ci/playwright-suites.schema.json",
  "title": "FsusUI release-critical Playwright suite registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dimensionKeys",
    "profiles",
    "suites"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dimensionKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "suite",
          "project",
          "browser",
          "viewport",
          "theme",
          "safeArea",
          "runtimeMode"
        ]
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "pr",
        "main",
        "nightly",
        "release"
      ],
      "additionalProperties": false
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/suite"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "string",
      "enum": [
        "pr",
        "main",
        "nightly",
        "release"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "browser"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ]
        },
        "viewport": {
          "enum": [
            "desktop",
            "mobile",
            "tiny"
          ]
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "safeArea": {
          "type": "boolean"
        },
        "runtimeMode": {
          "enum": [
            "prepared-reuse"
          ]
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "packageScript",
        "config",
        "runtimeType",
        "coverageKind",
        "profiles",
        "cells",
        "impactRoots",
        "artifacts",
        "affectedSkip"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "command": {
          "type": "string",
          "pattern": "^pnpm [a-z0-9:-]+$"
        },
        "packageScript": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "string",
          "pattern": "^vue/playwright[.a-z0-9-]+\\.config\\.ts$"
        },
        "runtimeType": {
          "type": "string",
          "minLength": 1
        },
        "coverageKind": {
          "enum": [
            "browser-compatibility",
            "geometry-contract",
            "visual-boundary-contract",
            "runtime-contract"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "impactRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "report",
            "trace",
            "screenshot",
            "receipt"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "trace": {
              "type": "string",
              "minLength": 1
            },
            "screenshot": {
              "type": "string",
              "minLength": 1
            },
            "receipt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "affectedSkip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "reasonTypes"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "reasonTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
