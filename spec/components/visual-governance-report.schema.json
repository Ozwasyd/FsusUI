{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsusui.dev/schema/visual-governance-report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "issue",
    "candidate",
    "digests",
    "allowlist",
    "baseline",
    "mutationSummary",
    "visualScenarios",
    "worktreeClean",
    "generated"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "fsusui.visual-governance-report.v1"
    },
    "issue": {
      "const": 404
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "digests": {
      "$ref": "#/$defs/digests"
    },
    "allowlist": {
      "$ref": "#/$defs/allowlist"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "mutationSummary": {
      "$ref": "#/$defs/mutationSummary"
    },
    "visualScenarios": {
      "$ref": "#/$defs/visualScenarios"
    },
    "worktreeClean": {
      "const": true
    },
    "generated": {
      "$ref": "#/$defs/generated"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "registry", "schema", "checkers", "rules"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "evaluator", "corpus"],
          "properties": {
            "registry": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evaluator": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "corpus": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "allowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "entries"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allowlistEntry"
          }
        }
      }
    },
    "allowlistEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "component",
        "part",
        "selector",
        "file",
        "reason",
        "owner",
        "testPolicy",
        "reviewAfter",
        "removalCondition"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\*).+$"
        },
        "part": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\*).+$"
        },
        "selector": {
          "type": "string",
          "pattern": "^\\.el-(?!.*\\*).+$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\*).+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "testPolicy": {
          "type": "string",
          "minLength": 1
        },
        "reviewAfter": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "removalCondition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiledCssDigest", "registryDigest", "violations"],
      "properties": {
        "compiledCssDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/violation"
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "componentId",
        "partId",
        "surfaceRole",
        "selector",
        "scope",
        "property",
        "reasonCode",
        "status",
        "expected",
        "actual"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "partId": {
          "type": "string",
          "minLength": 1
        },
        "surfaceRole": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme", "density", "media"],
          "properties": {
            "theme": {
              "enum": ["light", "dark"]
            },
            "density": {
              "type": "string"
            },
            "media": {
              "type": "string"
            }
          }
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "fail"
        },
        "expected": {
          "$ref": "#/$defs/expectedEvidence"
        },
        "actual": {
          "$ref": "#/$defs/actualEvidence"
        }
      }
    },
    "expectedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalReference"],
      "properties": {
        "canonicalReference": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "path", "pointer"],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "actualEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "column", "owner"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                },
                "owner": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "kind"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "mutationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "positiveFixtures"],
      "properties": {
        "cases": {
          "$ref": "#/$defs/mutationCases"
        },
        "positiveFixtures": {
          "$ref": "#/$defs/positiveFixtures"
        }
      }
    },
    "mutationCases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "killed", "notKilled"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "killed": {
          "type": "integer",
          "minimum": 0
        },
        "notKilled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "positiveFixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "green", "failed"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "green": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visualScenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "scenarios"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "status",
        "componentId",
        "partId",
        "ruleId",
        "selector",
        "scope",
        "fields",
        "verificationRequirement",
        "reasonCode",
        "states",
        "themes",
        "viewports",
        "zooms",
        "inputs",
        "expectedSemanticEvidence",
        "renderRequirements",
        "candidateIdentity"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "blocking"
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "partId": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationRequirement": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["light", "dark"]
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "width", "height"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "zooms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedSemanticEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "path", "pointer"],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "renderRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "requirement"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "candidateIdentity": {
          "$ref": "#/$defs/candidate"
        }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "sourceRevision", "digestAlgorithm"],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "digestAlgorithm": {
          "const": "sha256"
        }
      }
    }
  }
}
