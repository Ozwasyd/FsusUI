{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsusui.dev/schema/component-surface-semantic-registry.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "registryVersion",
    "owner",
    "reviewPolicy",
    "generated",
    "sourceDigests",
    "rules",
    "issueMappings"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": {
      "const": "fsusui.component-surface-semantic-registry.v1"
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "owner": { "$ref": "#/$defs/owner" },
    "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" },
    "generated": { "$ref": "#/$defs/generated" },
    "sourceDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sourceDigest" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "issueMappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issueMapping" }
    }
  },
  "$defs": {
    "canonicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path", "pointer"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "minLength": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "typography",
        "stateColor",
        "disabled",
        "motion",
        "surfaceCardMotif"
      ],
      "properties": {
        "geometry": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalReference" }
        },
        "typography": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalReference" }
        },
        "stateColor": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalReference" }
        },
        "disabled": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalReference" }
        },
        "motion": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalReference" }
        },
        "surfaceCardMotif": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalReference" }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "source",
        "scope",
        "constraintOverrides",
        "reviewPolicy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "source": { "$ref": "#/$defs/canonicalReference" },
        "scope": { "$ref": "#/$defs/scope" },
        "constraintOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "geometry": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "typography": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "stateColor": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "disabled": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "motion": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "surfaceCardMotif": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            }
          }
        },
        "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "sourceRevision", "digestAlgorithm"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "digestAlgorithm": { "const": "sha256" }
      }
    },
    "issueMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "errorId", "ruleIds", "semanticRoles"],
      "properties": {
        "issue": { "type": "integer", "minimum": 293, "maximum": 310 },
        "errorId": { "type": "string", "minLength": 1 },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "semanticRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^.]+\\.[^*]+$" }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ownerReviewRequired", "reviewAfter"],
      "properties": {
        "mode": { "const": "source-digest-required" },
        "ownerReviewRequired": { "const": true },
        "reviewAfter": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "partId",
        "surfaceRole",
        "issues",
        "owner",
        "selectorOwnership",
        "sourceOwnership",
        "canonicalSources",
        "constraints",
        "scope",
        "variants",
        "exceptions",
        "verificationPolicy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "partId": { "type": "string", "minLength": 1 },
        "surfaceRole": { "type": "string", "pattern": "^[^.]+\\.[^*]+$" },
        "issues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 293, "maximum": 310 }
        },
        "owner": { "$ref": "#/$defs/owner" },
        "selectorOwnership": { "$ref": "#/$defs/selectorOwnership" },
        "sourceOwnership": { "$ref": "#/$defs/sourceOwnership" },
        "canonicalSources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonicalReference" }
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "scope": { "$ref": "#/$defs/scope" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/exception" }
        },
        "verificationPolicy": { "$ref": "#/$defs/verificationPolicy" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themes", "densities", "devices"],
      "properties": {
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "densities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["default", "compact", "touch"] }
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["desktop", "mobile", "touch"] }
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "selector", "source"],
      "properties": {
        "platform": { "const": "web" },
        "selector": { "type": "string", "pattern": "^\\.el-" },
        "source": { "$ref": "#/$defs/canonicalReference" }
      }
    },
    "selectorOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "selectors"],
      "properties": {
        "owner": { "$ref": "#/$defs/owner" },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" }
        }
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "algorithm", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["authority", "implementation"] },
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "sourceOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "sources"],
      "properties": {
        "owner": { "$ref": "#/$defs/owner" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonicalReference" }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "source",
        "scope",
        "constraintOverrides",
        "reviewPolicy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "source": { "$ref": "#/$defs/canonicalReference" },
        "scope": { "$ref": "#/$defs/scope" },
        "constraintOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "geometry": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "typography": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "stateColor": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "disabled": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "motion": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            },
            "surfaceCardMotif": {
              "type": "array",
              "items": { "$ref": "#/$defs/canonicalReference" }
            }
          }
        },
        "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" }
      }
    },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staticFields", "visualProbeFields", "visualRequirements"],
      "properties": {
        "staticFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "geometry",
              "typography",
              "stateColor",
              "disabled",
              "motion"
            ]
          }
        },
        "visualProbeFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "surfaceCardMotif" }
        },
        "visualRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/visualRequirement" }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "visualRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "states",
        "themes",
        "viewports",
        "zooms",
        "inputs",
        "expectedSemanticEvidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["light", "dark"] }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/viewport" }
        },
        "zooms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedSemanticEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonicalReference" }
        }
      }
    }
  }
}
