{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/dependencies/update-surface.schema.json",
  "title": "FsusUI Renovate Update Surface Inventory",
  "description": "Maps every real version field to exactly one manager/group for governance verification (#415).",
  "type": "object",
  "required": ["schemaVersion", "surfaces", "exclusions", "governance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "datasource", "packageName", "manager", "files", "versioning", "group"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique stable identity. Must be unique across all surfaces.",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "datasource": {
            "type": "string",
            "enum": ["npm", "nuget", "github-releases", "node-version", "dotnet-version"]
          },
          "packageName": {
            "type": "string",
            "description": "Package or action name as Renovate sees it."
          },
          "manager": {
            "type": "string",
            "description": "Renovate manager name: npm, nuget, github-actions, dotnet-version, or regex."
          },
          "customManager": {
            "type": "string",
            "description": "Description of the custom regex manager (only when manager=regex)."
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "File paths containing the version reference."
          },
          "versioning": {
            "type": "string",
            "enum": ["semver", "semver-coerced", "node", "nuget", "loose"]
          },
          "group": {
            "type": "string",
            "description": "groupName from renovate.json5 packageRules."
          },
          "stabilityPolicy": {
            "type": "string",
            "enum": ["stable-only", "include-rc", "include-beta"],
            "default": "stable-only"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason", "owner", "createdAt", "reviewAfter", "removalCondition"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "field": { "type": "string" },
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "createdAt": { "type": "string"},
          "reviewAfter": { "type": "string"},
          "removalCondition": { "type": "string" }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": ["automerge", "majorEnabled", "minorEnabled", "patchEnabled", "digestEnabled", "lockfileMaintenanceEnabled", "permanentIgnoreCount"],
      "properties": {
        "automerge": { "const": false },
        "majorEnabled": { "const": true },
        "minorEnabled": { "const": true },
        "patchEnabled": { "const": true },
        "digestEnabled": { "const": true },
        "lockfileMaintenanceEnabled": { "const": true },
        "permanentIgnoreCount": { "const": 0 }
      }
    }
  }
}
