{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/dependencies/update-surface.schema.json",
  "title": "FsusUI Renovate Update Surface Inventory",
  "description": "Generated ownership map from every supported external version field to exactly one Renovate manager and semantic group.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedBy",
    "surfaces",
    "exclusions",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generatedBy": {
      "const": "node scripts/generate-update-surface.mjs"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "datasource",
          "packageName",
          "manager",
          "files",
          "versioning",
          "group",
          "stabilityPolicy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "datasource": {
            "type": "string",
            "enum": [
              "docker",
              "dotnet-version",
              "github-releases",
              "github-tags",
              "node-version",
              "npm",
              "nuget"
            ]
          },
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "authorityKey": {
            "type": "string",
            "minLength": 1
          },
          "manager": {
            "type": "string",
            "enum": [
              "custom.jsonata",
              "custom.regex",
              "dockerfile",
              "github-actions",
              "nuget"
            ]
          },
          "customManager": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "^(?:/|\\.\\./)"
              }
            }
          },
          "versioning": {
            "type": "string",
            "enum": [
              "docker",
              "loose",
              "node",
              "npm",
              "nuget",
              "semver",
              "semver-coerced"
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "stabilityPolicy": {
            "const": "stable-only"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "manager": {
                  "type": "string",
                  "pattern": "^custom\\."
                }
              },
              "required": [
                "manager"
              ]
            },
            "then": {
              "properties": {
                "customManager": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "customManager"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "customManager"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "manager": {
                  "type": "string",
                  "const": "custom.jsonata"
                }
              },
              "required": [
                "manager"
              ]
            },
            "then": {
              "properties": {
                "authorityKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "authorityKey"
              ]
            }
          }
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "field",
          "reason",
          "owner",
          "createdAt",
          "reviewAfter",
          "removalCondition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reviewAfter": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "removalCondition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automerge",
        "majorEnabled",
        "minorEnabled",
        "patchEnabled",
        "digestEnabled",
        "lockfileMaintenanceEnabled",
        "permanentIgnoreCount"
      ],
      "properties": {
        "automerge": {
          "const": true
        },
        "majorEnabled": {
          "const": true
        },
        "minorEnabled": {
          "const": true
        },
        "patchEnabled": {
          "const": true
        },
        "digestEnabled": {
          "const": true
        },
        "lockfileMaintenanceEnabled": {
          "const": true
        },
        "permanentIgnoreCount": {
          "const": 0
        }
      }
    }
  }
}
