{
  "schemaVersion": 1,
  "defaultBranch": "main",
  "requiredConclusions": ["success"],
  "rejectedConclusions": [
    "action_required",
    "cancelled",
    "failure",
    "missing",
    "neutral",
    "pending",
    "skipped",
    "stale",
    "timed_out"
  ],
  "branchProtection": {
    "strict": true,
    "requiredChecks": ["pr-fast", "pr-real-render-performance"]
  },
  "checks": {
    "pr-fast": {
      "workflow": ".github/workflows/quality.yml",
      "job": "pr-fast",
      "aggregates": [
        "premerge-main",
        "premerge-playwright",
        "pr-feedback",
        "pr-real-render-performance"
      ]
    },
    "pr-real-render-performance": {
      "workflow": ".github/workflows/quality.yml",
      "job": "pr-real-render-performance",
      "aggregates": ["real-render-performance"]
    }
  },
  "groups": {
    "avalonia-platform": {
      "updateTypes": ["digest", "major", "minor", "patch"],
      "requiredChecks": ["pr-fast", "pr-real-render-performance"],
      "requiredGateEvidence": [
        "consumer-install",
        "dotnet-package",
        "dotnet-platform",
        "real-render-performance",
        "static-quality",
        "typecheck",
        "unit"
      ]
    },
    "dotnet-build-toolchain": {
      "updateTypes": ["digest", "major", "minor", "patch"],
      "requiredChecks": ["pr-fast", "pr-real-render-performance"],
      "requiredGateEvidence": [
        "consumer-install",
        "dotnet-package",
        "dotnet-platform",
        "real-render-performance",
        "static-quality",
        "typecheck",
        "unit"
      ]
    },
    "dotnet-test-performance": {
      "updateTypes": ["digest", "major", "minor", "patch"],
      "requiredChecks": ["pr-fast", "pr-real-render-performance"],
      "requiredGateEvidence": [
        "dotnet-package",
        "dotnet-platform",
        "real-render-performance",
        "static-quality",
        "unit"
      ]
    },
    "github-actions": {
      "updateTypes": ["digest", "major", "minor", "patch"],
      "requiredChecks": ["pr-fast", "pr-real-render-performance"],
      "requiredGateEvidence": [
        "build-demo",
        "build-package",
        "consumer-install",
        "coverage",
        "dotnet-package",
        "dotnet-platform",
        "playwright-boundary",
        "playwright-layout",
        "playwright-markdown",
        "playwright-motion",
        "real-render-performance",
        "static-quality",
        "typecheck",
        "unit",
        "visual",
        "visual-runtime-reuse"
      ]
    },
    "js-test-quality-tooling": {
      "updateTypes": ["digest", "major", "minor", "patch"],
      "requiredChecks": ["pr-fast", "pr-real-render-performance"],
      "requiredGateEvidence": [
        "coverage",
        "playwright-boundary",
        "playwright-layout",
        "playwright-markdown",
        "playwright-motion",
        "real-render-performance",
        "static-quality",
        "typecheck",
        "unit",
        "visual-runtime-reuse"
      ]
    },
    "node-dotnet-sdk-images": {
