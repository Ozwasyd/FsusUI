<Window
  x:Class="FsusUI.Avalonia.Themes.Smoke.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Classes="fsus-dialog"
  Height="320"
  Title="FsusUI Avalonia Theme Smoke"
  Width="480">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock FontSize="{DynamicResource FsusTypographyHeadingLgSize}" Text="FsusUI Avalonia" />
    <TextBox PlaceholderText="Theme smoke input" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="fsus-primary">Primary</Button>
      <Button>Default</Button>
      <Button Classes="fsus-loading">Loading</Button>
    </StackPanel>
    <Border Classes="fsus-card">
      <StackPanel Spacing="8">
        <TextBlock Text="Generated tokens are loaded through FsusTheme.axaml." />
        <ToggleSwitch Content="Motion enabled" IsChecked="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
