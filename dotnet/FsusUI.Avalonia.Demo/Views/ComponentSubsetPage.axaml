<UserControl
  x:Class="FsusUI.Avalonia.Demo.Views.ComponentSubsetPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="14">
    <Border Classes="fsus-card">
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="700" Text="Commands" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <fsus:FsusButton
            AccessibleName="Save primary action"
            Variant="Primary">
            Primary
          </fsus:FsusButton>
          <fsus:FsusButton IsPlain="True">Plain</fsus:FsusButton>
          <fsus:FsusButton IsLoading="True">Loading</fsus:FsusButton>
          <fsus:FsusButtonGroup Variant="Primary" Size="Sm">
            <fsus:FsusButton IconPlacement="Leading">Previous</fsus:FsusButton>
            <fsus:FsusButton IconPlacement="Trailing">Next</fsus:FsusButton>
          </fsus:FsusButtonGroup>
          <fsus:FsusIconButton
            AccessibleName="Open command palette"
            Variant="Text">
            <fsus:FsusIcon
              Data="{StaticResource FsusIconSearch}"
              IconKey="FsusIconSearch" />
          </fsus:FsusIconButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <fsus:FsusIcon
            AccessibleName="Warning"
            Data="{StaticResource FsusIconWarning}"
            IconKey="FsusIconWarning"
            IsDecorative="False" />
          <fsus:FsusText Variant="Strong">Semantic icon with text baseline</fsus:FsusText>
          <fsus:FsusLink
            AccessibleName="Open Avalonia parity guide"
            NavigateUri="https://fsus.dev/avalonia">
            Avalonia parity guide
          </fsus:FsusLink>
        </StackPanel>
        <fsus:FsusText
          MaxWidth="260"
          IsTruncated="True"
          Text="FsusText truncates long operational labels without changing row height." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <fsus:FsusText Variant="Muted">Muted</fsus:FsusText>
          <fsus:FsusText Variant="Monospace">code-variant</fsus:FsusText>
          <fsus:FsusText Variant="Title">Title</fsus:FsusText>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="fsus-card">
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="700" Text="Form controls" />
        <fsus:FsusInput PlaceholderText="FsusInput" />
        <fsus:FsusInput IsInvalid="True" Text="Invalid input state" />
        <fsus:FsusTextarea Text="FsusTextarea validates multiline input and wrapping." />
        <fsus:FsusCheckbox IsChecked="True">FsusCheckbox</fsus:FsusCheckbox>
        <fsus:FsusRadio GroupName="subset" IsChecked="True">FsusRadio selected</fsus:FsusRadio>
        <fsus:FsusSwitch IsChecked="True" Content="FsusSwitch" />
      </StackPanel>
    </Border>

    <Border Classes="fsus-card">
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="700" Text="Surfaces and feedback" />
        <fsus:FsusCard IsSelected="True">
          <TextBlock Text="FsusCard selected surface" />
        </fsus:FsusCard>
        <fsus:FsusDivider />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <fsus:FsusTag Content="FsusTag" />
          <fsus:FsusBadge Content="12" />
          <fsus:FsusAlert Variant="Danger" Content="FsusAlert danger state" />
        </StackPanel>
        <fsus:FsusDialog IsLoading="True">
          <TextBlock Text="FsusDialog surface with loading state" />
        </fsus:FsusDialog>
      </StackPanel>
    </Border>

    <Border Classes="fsus-card">
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="700" Text="Navigation" />
        <fsus:FsusTabs>
          <TabItem Header="Overview">
            <TextBlock Margin="8" Text="FsusTabs overview panel" />
          </TabItem>
          <TabItem Header="Disabled" IsEnabled="False">
            <TextBlock Margin="8" Text="Disabled panel" />
          </TabItem>
        </fsus:FsusTabs>
        <fsus:FsusMenu>
          <MenuItem Header="FsusMenu item" />
          <MenuItem Header="Disabled item" IsEnabled="False" />
        </fsus:FsusMenu>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
