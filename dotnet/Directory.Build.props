<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.0.0-preview.0</Version>
    <Authors>FsusUI</Authors>
    <Company>FsusUI</Company>
    <RepositoryUrl>https://github.com/Ozwasyd/FsusUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>fsusui;avalonia;components;design-system;cross-platform</PackageTags>
    <PackageReleaseNotes>Stable Avalonia package candidate. The three public packages are AOT-compatible libraries; final RID-specific Native AOT publish and run remain consuming-application release gates. Public API baselines, package metadata, symbol packages, dependency review, package content audit, and packed consumer verification guard stable NuGet readiness.</PackageReleaseNotes>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' and Exists('README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
