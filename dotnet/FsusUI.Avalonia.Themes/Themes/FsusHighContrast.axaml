<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="FsusThemeBackgroundBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeSurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeSurfaceRaisedBrush" Color="#111827" />
  <SolidColorBrush x:Key="FsusThemePickerSurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeDateTimeSurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeValuePickerTrackBrush" Color="#1F2937" />
  <SolidColorBrush x:Key="FsusThemeUploadSurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeDataDisplaySurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeMediaSurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="FsusThemeTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeMutedTextBrush" Color="#FDE68A" />
  <SolidColorBrush x:Key="FsusThemeBorderBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeFocusBrush" Color="#FFFF00" />
  <SolidColorBrush x:Key="FsusThemeDangerBrush" Color="#FF6B6B" />
  <SolidColorBrush x:Key="FsusThemeDisabledSurfaceBrush" Color="#1F2937" />
  <SolidColorBrush x:Key="FsusThemeLoadingBrush" Color="#1F2937" />
  <x:Double x:Key="FsusThemeDisabledOpacity">0.72</x:Double>
  <x:Double x:Key="FsusThemeFocusThickness">3</x:Double>
</ResourceDictionary>
