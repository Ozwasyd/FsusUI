<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="CheckBox, RadioButton, ToggleSwitch, fsus|FsusCheckbox, fsus|FsusRadio, fsus|FsusSwitch">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="CheckBox:disabled, RadioButton:disabled, ToggleSwitch:disabled, fsus|FsusCheckbox:disabled, fsus|FsusRadio:disabled, fsus|FsusSwitch:disabled, fsus|FsusCheckbox.fsus-disabled, fsus|FsusRadio.fsus-disabled, fsus|FsusSwitch.fsus-disabled">
    <Setter Property="Background" Value="{DynamicResource FsusThemeDisabledSurfaceBrush}" />
    <Setter Property="Opacity" Value="{DynamicResource FsusThemeDisabledOpacity}" />
  </Style>

  <Style Selector="CheckBox:checked, RadioButton:checked, ToggleSwitch:checked, fsus|FsusCheckbox:checked, fsus|FsusRadio:checked, fsus|FsusSwitch:checked, fsus|FsusCheckbox.fsus-checked, fsus|FsusRadio.fsus-checked, fsus|FsusSwitch.fsus-checked">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusCheckbox.fsus-indeterminate">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeFocusBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
  </Style>

  <Style Selector="fsus|FsusCheckbox.fsus-unchecked, fsus|FsusRadio.fsus-unchecked, fsus|FsusSwitch.fsus-unchecked">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusCheckbox.fsus-loading, fsus|FsusRadio.fsus-loading, fsus|FsusSwitch.fsus-loading">
    <Setter Property="Background" Value="{DynamicResource FsusThemeLoadingBrush}" />
  </Style>

  <Style Selector="CheckBox:focus, RadioButton:focus, ToggleSwitch:focus, fsus|FsusCheckbox:focus, fsus|FsusRadio:focus, fsus|FsusSwitch:focus, fsus|FsusCheckbox.fsus-focus-visible, fsus|FsusRadio.fsus-focus-visible, fsus|FsusSwitch.fsus-focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusThemeFocusThickness}" />
  </Style>

  <Style Selector="fsus|FsusCheckbox.fsus-size-sm, fsus|FsusRadio.fsus-size-sm, fsus|FsusSwitch.fsus-size-sm">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="fsus|FsusCheckbox.fsus-size-lg, fsus|FsusRadio.fsus-size-lg, fsus|FsusSwitch.fsus-size-lg">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="fsus|FsusCheckboxGroup, fsus|FsusRadioGroup">
    <Setter Property="Spacing" Value="6" />
  </Style>

  <Style Selector="fsus|FsusCheckboxGroup.fsus-disabled, fsus|FsusRadioGroup.fsus-disabled">
    <Setter Property="Opacity" Value="{DynamicResource FsusThemeDisabledOpacity}" />
  </Style>
</Styles>
