<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.fsus-card">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
  </Style>

  <Style Selector="fsus|FsusCard">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
            <ContentPresenter
              Grid.Row="0"
              Grid.Column="0"
              Content="{TemplateBinding IconContent}" />
            <StackPanel Grid.Row="0" Grid.Column="1">
              <TextBlock
                FontFamily="{DynamicResource FsusTypographyFamilyBody}"
                FontSize="{DynamicResource FsusTypographyBodyMdSize}"
                FontWeight="{DynamicResource FsusTypographyBodyMdWeight}"
                Foreground="{DynamicResource FsusThemeTextBrush}"
                Text="{TemplateBinding Title}" />
              <TextBlock
                FontFamily="{DynamicResource FsusTypographyFamilyBody}"
                FontSize="{DynamicResource FsusTypographyBodyMdSize}"
                Foreground="{DynamicResource FsusThemeMutedTextBrush}"
                Text="{TemplateBinding Description}"
                TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ContentPresenter
              Grid.Row="2"
              Grid.ColumnSpan="2"
              Content="{TemplateBinding ActionContent}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Border.fsus-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="fsus|FsusCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="Border.fsus-card.fsus-selected">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusCard.fsus-selected">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="ContentControl.fsus-card">
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>
</Styles>
