<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="Window.fsus-dialog">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="MinWidth" Value="{DynamicResource FsusComponentDialogMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource FsusComponentDialogMinHeight}" />
  </Style>

  <Style Selector="Border.fsus-dialog-surface">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
  </Style>

  <Style Selector="fsus|FsusDialog">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-legacy-content)">
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}"
          Padding="{TemplateBinding Padding}">
          <Grid RowDefinitions="Auto,*,Auto">
            <ContentPresenter
              Name="PART_HeaderPresenter"
              Grid.Row="0"
              Content="{TemplateBinding Title}"
              FontWeight="SemiBold"
              FontSize="{DynamicResource FsusTypographyBodyMdSize}" />
            <ContentPresenter
              Name="PART_BodyPresenter"
              Grid.Row="1"
              Content="{TemplateBinding BodyContent}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <StackPanel
              Grid.Row="2"
              Orientation="Horizontal">
              <ContentPresenter
                Name="PART_FooterPresenter"
                Content="{TemplateBinding FooterContent}" />
              <ContentPresenter
                Name="PART_ConfirmPresenter"
                Content="{TemplateBinding ConfirmContent}" />
              <ContentPresenter
                Name="PART_CancelPresenter"
                Content="{TemplateBinding CancelContent}" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-title) /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-has-title /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-body-content) /template/ ContentPresenter#PART_BodyPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-footer) /template/ ContentPresenter#PART_FooterPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-has-footer /template/ ContentPresenter#PART_FooterPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-confirm) /template/ ContentPresenter#PART_ConfirmPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-has-confirm /template/ ContentPresenter#PART_ConfirmPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-cancel) /template/ ContentPresenter#PART_CancelPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-has-cancel /template/ ContentPresenter#PART_CancelPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body">
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}"
          Padding="{TemplateBinding Padding}">
          <Grid RowDefinitions="Auto,*,Auto">
            <ContentPresenter
              Name="PART_HeaderPresenter"
              Grid.Row="0"
              Content="{TemplateBinding Title}"
              FontWeight="SemiBold"
              FontSize="{DynamicResource FsusTypographyBodyMdSize}" />
            <ScrollViewer
              Name="PART_BodyScrollViewer"
              Grid.Row="1"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
              <Grid>
                <ContentPresenter
                  Name="PART_ContentPresenter"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                <ContentPresenter
                  Name="PART_BodyPresenter"
                  Content="{TemplateBinding BodyContent}"
                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </ScrollViewer>
            <ContentPresenter
              Name="PART_FooterPresenter"
              Grid.Row="2"
              Content="{TemplateBinding FooterContent}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body:not(.fsus-has-title) /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body.fsus-has-title /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body:not(.fsus-has-footer) /template/ ContentPresenter#PART_FooterPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body.fsus-has-footer /template/ ContentPresenter#PART_FooterPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body.fsus-has-body-content /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body:not(.fsus-has-body-content) /template/ ContentPresenter#PART_BodyPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Border.fsus-overlay">
    <Setter Property="Background" Value="{DynamicResource FsusComponentOverlayScrimBrush}" />
  </Style>
</Styles>
