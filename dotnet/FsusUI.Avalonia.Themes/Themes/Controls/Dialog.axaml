<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="Window.fsus-dialog">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="MinWidth" Value="{DynamicResource FsusComponentDialogMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource FsusComponentDialogMinHeight}" />
  </Style>

  <Style Selector="Border.fsus-dialog-surface">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
  </Style>

  <Style Selector="fsus|FsusDialog, fsus|FsusMessageBox">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}"
          Padding="{TemplateBinding Padding}">
          <Grid RowDefinitions="Auto,*,Auto">
            <ContentPresenter
              Name="PART_HeaderPresenter"
              Grid.Row="0"
              Content="{TemplateBinding Title}"
              FontWeight="SemiBold"
              FontSize="{DynamicResource FsusTypographyBodyMdSize}" />
            <ScrollViewer
              Name="PART_ScrollViewer"
              Grid.Row="1"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Disabled">
              <ContentPresenter
                Name="PART_BodyPresenter"
                Content="{TemplateBinding EffectiveBodyContent}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ScrollViewer>
            <ContentPresenter
              Name="PART_FooterPresenter"
              Grid.Row="2"
              Content="{TemplateBinding EffectiveFooterContent}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-title) /template/ ContentPresenter#PART_HeaderPresenter, fsus|FsusMessageBox:not(.fsus-has-title) /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-has-title /template/ ContentPresenter#PART_HeaderPresenter, fsus|FsusMessageBox.fsus-has-title /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style Selector="fsus|FsusDialog:not(.fsus-has-footer) /template/ ContentPresenter#PART_FooterPresenter, fsus|FsusMessageBox:not(.fsus-has-footer) /template/ ContentPresenter#PART_FooterPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-has-footer /template/ ContentPresenter#PART_FooterPresenter, fsus|FsusMessageBox.fsus-has-footer /template/ ContentPresenter#PART_FooterPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <Style Selector="fsus|FsusDialog.fsus-scrollable-body /template/ ScrollViewer#PART_ScrollViewer, fsus|FsusMessageBox.fsus-scrollable-body /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style Selector="Border.fsus-overlay">
    <Setter Property="Background" Value="{DynamicResource FsusComponentOverlayScrimBrush}" />
  </Style>
</Styles>
