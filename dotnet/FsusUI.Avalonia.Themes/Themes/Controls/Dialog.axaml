<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="Window.fsus-dialog">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="MinWidth" Value="{DynamicResource FsusComponentDialogMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource FsusComponentDialogMinHeight}" />
  </Style>

  <Style Selector="Border.fsus-dialog-surface">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
  </Style>

  <Style Selector="fsus|FsusDialog">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusComponentDialogPadding}" />
  </Style>

  <Style Selector="Border.fsus-overlay">
    <Setter Property="Background" Value="{DynamicResource FsusComponentOverlayScrimBrush}" />
  </Style>
</Styles>
