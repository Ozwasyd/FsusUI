<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">

  <Style Selector="fsus|FsusCheckTag">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodySmSize}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border
            Background="{TemplateBinding Background}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Foreground="{TemplateBinding Foreground}"
              FontWeight="{TemplateBinding FontWeight}"
              FontSize="{TemplateBinding FontSize}"
              VerticalAlignment="Center" />
          </Border>
          <Border
            Name="PART_FocusRing"
            BorderBrush="{DynamicResource FsusThemeFocusBrush}"
            CornerRadius="{TemplateBinding CornerRadius}"
            IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusCheckTag.fsus-checked">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeFocusBrush}" />
  </Style>

  <Style Selector="fsus|FsusCheckTag:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
