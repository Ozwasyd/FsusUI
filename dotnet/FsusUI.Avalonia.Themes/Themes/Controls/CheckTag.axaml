<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">

  <!-- Web authority: fsus-theme.scss `.el-check-tag` (fsus-control base plus
       the 1370 override): fill.lighter surface, 1px border.subtle outline,
       6px control radius, text.quiet label at 11px/700, 4px×16px padding.
       Checked state fills scholarly-blue with paper-white text. -->
  <Style Selector="fsus|FsusCheckTag">
    <Setter Property="Background" Value="{DynamicResource FsusColorFillLighterBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Foreground="{TemplateBinding Foreground}"
              FontWeight="{TemplateBinding FontWeight}"
              FontSize="{TemplateBinding FontSize}"
              VerticalAlignment="Center" />
          </Border>
          <Border
            Name="PART_FocusRing"
            BorderBrush="{DynamicResource FsusThemeFocusBrush}"
            CornerRadius="{TemplateBinding CornerRadius}"
            IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusCheckTag.fsus-checked">
    <Setter Property="Background" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusColorSurfaceBaseBrush}" />
  </Style>

  <Style Selector="fsus|FsusCheckTag:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
