<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:conv="using:Avalonia.Data.Converters"
  xmlns:fsus="using:FsusUI.Avalonia.Controls"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="fsus|FsusTag, fsus|FsusBadge, fsus|FsusAlert">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
  </Style>

  <Style Selector="fsus|FsusTag">
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          MinHeight="{TemplateBinding MinHeight}"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="Auto,*">
            <ContentPresenter
              Grid.Column="0"
              Content="{TemplateBinding IconContent}" />
            <ContentPresenter
              Grid.Column="1"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusBadge">
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          MinHeight="{TemplateBinding MinHeight}"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="Auto,*">
            <ContentPresenter
              Grid.Column="0"
              Content="{TemplateBinding IconContent}" />
            <ContentPresenter
              Grid.Column="1"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusAlert">
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          MinHeight="{TemplateBinding MinHeight}"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <ContentPresenter
              Grid.Row="0"
              Grid.Column="0"
              Content="{TemplateBinding IconContent}" />
            <StackPanel Grid.Row="0" Grid.Column="1">
              <TextBlock
                FontFamily="{DynamicResource FsusTypographyFamilyBody}"
                FontSize="{DynamicResource FsusTypographyBodyMdSize}"
                FontWeight="{DynamicResource FsusTypographyBodyMdWeight}"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding Title}" />
              <TextBlock
                FontFamily="{DynamicResource FsusTypographyFamilyBody}"
                FontSize="{DynamicResource FsusTypographyBodyMdSize}"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding Description}"
                TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ContentPresenter
              Grid.Row="2"
              Grid.ColumnSpan="2"
              Content="{TemplateBinding ActionContent}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusTag.fsus-primary, fsus|FsusBadge.fsus-primary, fsus|FsusAlert.fsus-primary">
    <Setter Property="Background" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusPrimitiveColorWhiteBrush}" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-danger, fsus|FsusBadge.fsus-danger, fsus|FsusAlert.fsus-danger">
    <Setter Property="Background" Value="{DynamicResource FsusThemeDangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusPrimitiveColorWhiteBrush}" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-selected, fsus|FsusBadge.fsus-selected, fsus|FsusAlert.fsus-warning">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-removed, fsus|FsusAlert.fsus-dismissed">
    <Setter Property="Opacity" Value="{DynamicResource FsusOpacityDisabledContent}" />
  </Style>

  <Style Selector="fsus|FsusDivider">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <TextBlock
            Name="PART_Title"
            Text="{TemplateBinding Title}"
            FontSize="13"
            FontWeight="Medium"
            Foreground="{TemplateBinding Foreground}"
            Margin="0,0,0,12"
            IsVisible="False" />
          <Border
            Name="PART_Line"
            Height="1"
            Background="{DynamicResource FsusColorBorderLighterBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDivider.fsus-has-title /template/ TextBlock#PART_Title">
    <Setter Property="IsVisible" Value="True" />
  </Style>
</Styles>
