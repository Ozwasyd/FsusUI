<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:conv="using:Avalonia.Data.Converters"
  xmlns:fsus="using:FsusUI.Avalonia.Controls"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="fsus|FsusTag, fsus|FsusBadge, fsus|FsusAlert">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
  </Style>

  <Style Selector="fsus|FsusTag">
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          MinHeight="{TemplateBinding MinHeight}"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="Auto,*">
            <ContentPresenter
              Grid.Column="0"
              Content="{TemplateBinding IconContent}" />
            <ContentPresenter
              Grid.Column="1"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusBadge.fsus-dot /template/ Border#PART_BadgeMark">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="fsus|FsusBadge">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" />
          <Border
            Name="PART_BadgeMark"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="999"
            Background="{DynamicResource FsusThemeDangerBrush}"
            BorderBrush="{DynamicResource FsusThemeSurfaceBrush}"
            BorderThickness="2"
            Width="14"
            Height="14"
            Margin="0,-7,-9,0"
            IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusAlert">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="Padding" Value="16,9,8,9" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
  </Style>

  <Style Selector="fsus|FsusAlert">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="4,*">
          <Border
            Grid.Column="0"
            Name="PART_Stripe"
            Background="{DynamicResource FsusThemeBorderBrush}"
            Margin="0,2" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock
              FontFamily="{DynamicResource FsusTypographyFamilyBody}"
              FontSize="{DynamicResource FsusTypographyBodyMdSize}"
              FontWeight="Medium"
              Foreground="{TemplateBinding Foreground}"
              Text="{TemplateBinding Title}" />
            <TextBlock
              Name="PART_AlertDescription"
              FontFamily="{DynamicResource FsusTypographyFamilyBody}"
              FontSize="{DynamicResource FsusTypographyBodyMdSize}"
              Foreground="{TemplateBinding Foreground}"
              Text="{TemplateBinding Description}"
              IsVisible="False"
              TextWrapping="Wrap" />
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ContentPresenter Content="{TemplateBinding ActionContent}" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusAlert.fsus-success /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="#166534" />
  </Style>

  <Style Selector="fsus|FsusAlert.fsus-info /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusAlert.fsus-warning /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="#92400E" />
  </Style>

  <Style Selector="fsus|FsusAlert.fsus-danger /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="#991B1B" />
  </Style>

  <Style Selector="fsus|FsusAlert.fsus-has-description /template/ TextBlock#PART_AlertDescription">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-primary, fsus|FsusBadge.fsus-primary, fsus|FsusAlert.fsus-primary">
    <Setter Property="Background" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusPrimitiveColorWhiteBrush}" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-danger, fsus|FsusBadge.fsus-danger, fsus|FsusAlert.fsus-danger">
    <Setter Property="Background" Value="{DynamicResource FsusThemeDangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusPrimitiveColorWhiteBrush}" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-selected, fsus|FsusBadge.fsus-selected, fsus|FsusAlert.fsus-warning">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-success">
    <Setter Property="Foreground" Value="#16A34A" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-warning">
    <Setter Property="Foreground" Value="#D97706" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-danger">
    <Setter Property="Foreground" Value="#DC2626" />
  </Style>

  <Style Selector="fsus|FsusTag.fsus-removed, fsus|FsusAlert.fsus-dismissed">
    <Setter Property="Opacity" Value="{DynamicResource FsusOpacityDisabledContent}" />
  </Style>

  <Style Selector="fsus|FsusDivider">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <TextBlock
            Name="PART_Title"
            Text="{TemplateBinding Title}"
            FontSize="13"
            FontWeight="Medium"
            Foreground="{TemplateBinding Foreground}"
            Margin="0,0,0,12"
            IsVisible="False" />
          <Border
            Name="PART_Line"
            Height="1"
            Background="{DynamicResource FsusColorBorderLighterBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDivider.fsus-has-title /template/ TextBlock#PART_Title">
    <Setter Property="IsVisible" Value="True" />
  </Style>
</Styles>
