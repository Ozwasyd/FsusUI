<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="fsus|FsusPublicShell">
    <Setter Property="Padding" Value="{DynamicResource FsusSpace3}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemePublicShellSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusPublicShell.fsus-mobile">
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
  </Style>

  <Style Selector="fsus|FsusPublicShell.fsus-active-indicator">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
  </Style>

  <Style Selector="fsus|FsusSiteHeader">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemePublicShellSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="0 0 0 1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="{DynamicResource FsusMotionDurationEffective}"
          Easing="{DynamicResource FsusMotionEasingEffective}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusSiteHeader.fsus-sticky">
    <Setter Property="Opacity" Value="0.98" />
  </Style>

  <Style Selector="fsus|FsusResponsiveCollection">
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusResponsiveCollection.fsus-compact">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="fsus|FsusThemeModeToggle">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace1}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
  </Style>

  <Style Selector="fsus|FsusThemeModeToggle.fsus-mode-dark">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
  </Style>

  <Style Selector="fsus|FsusThemeModeToggle.fsus-visibility-mobile">
    <Setter Property="Opacity" Value="0.96" />
  </Style>
</Styles>
