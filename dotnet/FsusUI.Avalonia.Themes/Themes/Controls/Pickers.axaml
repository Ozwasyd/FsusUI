<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="fsus|FsusSelect, fsus|FsusSelectV2, fsus|FsusAutocomplete, fsus|FsusCascader">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemePickerSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="{DynamicResource FsusMotionDurationEffective}"
          Easing="{DynamicResource FsusMotionEasingEffective}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusSelect.fsus-open, fsus|FsusSelectV2.fsus-open, fsus|FsusAutocomplete.fsus-open, fsus|FsusCascader.fsus-open">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
  </Style>

  <Style Selector="fsus|FsusSelect.fsus-empty, fsus|FsusSelectV2.fsus-empty, fsus|FsusAutocomplete.fsus-empty, fsus|FsusCascader.fsus-empty">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusSelect.fsus-disabled, fsus|FsusSelectV2.fsus-disabled, fsus|FsusAutocomplete.fsus-disabled, fsus|FsusCascader.fsus-disabled">
    <Setter Property="Background" Value="{DynamicResource FsusThemeDisabledSurfaceBrush}" />
    <Setter Property="Opacity" Value="{DynamicResource FsusThemeDisabledOpacity}" />
  </Style>

  <Style Selector="fsus|FsusOptionGroup">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusOption">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusOption.fsus-highlighted">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="fsus|FsusOption.fsus-selected">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
  </Style>

  <Style Selector="fsus|FsusOption.fsus-disabled">
    <Setter Property="Opacity" Value="{DynamicResource FsusThemeDisabledOpacity}" />
  </Style>

  <Style Selector="fsus|FsusCascaderPanel">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemePickerSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
  </Style>

  <Style Selector="fsus|FsusAutocomplete TextBox#PART_TextBox, fsus|FsusAutocomplete /template/ TextBox#PART_TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="fsus|FsusAutocomplete.fsus-size-sm">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
  </Style>

  <Style Selector="fsus|FsusAutocomplete.fsus-size-sm TextBox#PART_TextBox, fsus|FsusAutocomplete.fsus-size-sm /template/ TextBox#PART_TextBox">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="fsus|FsusAutocomplete.fsus-size-lg">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style Selector="Border.fsus-autocomplete-popup-border">
    <Setter Property="Background" Value="{DynamicResource FsusThemePickerSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
  </Style>
</Styles>
