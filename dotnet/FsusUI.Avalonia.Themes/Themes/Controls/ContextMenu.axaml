<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="fsus|FsusContextMenu">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusBorderControlWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusSurfaceMd}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace1}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="{DynamicResource FsusMotionDurationEffective}"
          Easing="{DynamicResource FsusMotionEasingEffective}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusContextMenu.fsus-open">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="fsus|FsusContextMenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlDefaultY}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="{DynamicResource FsusMotionDurationEffective}"
          Easing="{DynamicResource FsusMotionEasingEffective}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusContextMenuItem.fsus-focused">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="fsus|FsusContextMenuItem.fsus-dangerous">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeDangerBrush}" />
  </Style>

  <Style Selector="fsus|FsusContextMenuItem.fsus-disabled">
    <Setter Property="Opacity" Value="{DynamicResource FsusThemeDisabledOpacity}" />
  </Style>

  <Style Selector="fsus|FsusContextMenuSeparator">
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeBorderBrush}" />
  </Style>
</Styles>
