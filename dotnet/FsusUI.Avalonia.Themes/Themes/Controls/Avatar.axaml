<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">

  <!-- Web authority: fsus-theme.scss `.el-avatar` override — fill.base
       surface, 1px border.subtle outline, text.primary foreground. The
       theme-chalk gray disc (bg = text-color-disabled, white text) is
       replaced by the FsusUI minimalist outlined avatar. -->
  <Style Selector="fsus|FsusAvatar">
    <Setter Property="Background" Value="{DynamicResource FsusColorFillBaseBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Name="PART_Clip"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          Width="{TemplateBinding Size}"
          Height="{TemplateBinding Size}"
          ClipToBounds="True"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
          <ContentPresenter
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{TemplateBinding Foreground}"
            FontSize="{TemplateBinding FontSize}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusAvatar.fsus-circle /template/ Border#PART_Clip">
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="fsus|FsusAvatar.fsus-square /template/ Border#PART_Clip">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</Styles>
