<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:fsus="using:FsusUI.Avalonia.Controls">
  <Style Selector="fsus|FsusActivityRailShell">
    <Setter Property="Background" Value="{DynamicResource FsusThemeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
  </Style>

  <Style Selector="Border.fsus-activity-rail">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.fsus-contextual-pane">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace4}" />
  </Style>

  <Style Selector="Thumb.fsus-contextual-pane-resizer">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>

  <Style Selector="Thumb.fsus-contextual-pane-resizer:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="Thumb.fsus-contextual-pane-resizer:focus-visible">
    <Setter Property="Background" Value="{DynamicResource FsusThemeFocusBrush}" />
  </Style>

  <Style Selector="fsus|FsusActivityRailSection">
    <Setter Property="Width" Value="{DynamicResource FsusDensityIconTarget}" />
    <Setter Property="Height" Value="{DynamicResource FsusDensityIconTarget}" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource FsusRadiusControlMd}" />
  </Style>

  <Style Selector="fsus|FsusActivityRailSection:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusActivityRailSection.fsus-selected">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusActivityRailSection:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusThemeFocusBorderThickness}" />
  </Style>

  <Style Selector="fsus|FsusActivityRailSection:disabled">
    <Setter Property="Background" Value="{DynamicResource FsusThemeDisabledSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusDocumentTabs">
    <Setter Property="Background" Value="{DynamicResource FsusThemeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <Border
            Background="{DynamicResource FsusThemeSurfaceRaisedBrush}"
            BorderBrush="{DynamicResource FsusThemeBorderBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer
              Name="PART_HeaderScrollViewer"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter
                Name="PART_ItemsPresenter"
                ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </Border>
          <ContentPresenter
            Name="PART_SelectedContentHost"
            Grid.Row="1"
            Content="{TemplateBinding SelectedContent}"
            ContentTemplate="{TemplateBinding SelectedContentTemplate}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDocumentTab">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="Padding" Value="{DynamicResource FsusSpace2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          MinHeight="{TemplateBinding MinHeight}"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border
              Name="PART_DirtyIndicator"
              Width="6"
              Height="6"
              CornerRadius="{DynamicResource FsusRadiusPill}"
              Background="{DynamicResource FsusThemeTextBrush}"
              IsVisible="{TemplateBinding IsDirty}"
              VerticalAlignment="Center" />
            <ContentPresenter
              Grid.Column="1"
              Content="{TemplateBinding Header}"
              ContentTemplate="{TemplateBinding HeaderTemplate}"
              HorizontalAlignment="Left"
              VerticalAlignment="Center" />
            <Button
              Name="PART_CloseButton"
              Grid.Column="2"
              Classes="fsus-title-bar-window-action"
              Content="×"
              IsVisible="{TemplateBinding IsClosable}"
              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="fsus|FsusDocumentTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
  </Style>

  <Style Selector="fsus|FsusDocumentTab.fsus-selected">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusColorActionPrimaryBrush}" />
  </Style>

  <Style Selector="fsus|FsusDocumentTab:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusThemeFocusBorderThickness}" />
  </Style>

  <Style Selector="fsus|FsusDocumentTab.fsus-dragging">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="fsus|FsusNativeTitleBar">
    <Setter Property="MinHeight" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontFamily" Value="{DynamicResource FsusTypographyFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyBodyMdSize}" />
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>

  <Style Selector="Grid.fsus-native-title-bar-layout">
    <Setter Property="ColumnSpacing" Value="8" />
  </Style>

  <Style Selector="Grid.fsus-title-bar-document">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.fsus-title-bar-title">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.fsus-title-bar-path">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FsusTypographyCaptionMdSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ContentPresenter.fsus-title-bar-status">
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeMutedTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.fsus-title-bar-window-action">
    <Setter Property="MinWidth" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="Width" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="Height" Value="{DynamicResource FsusDensityControlCompactY}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FsusThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.fsus-title-bar-window-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusThemeSurfaceBrush}" />
  </Style>

  <Style Selector="Button.fsus-title-bar-window-action:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FsusThemeFocusBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FsusThemeFocusBorderThickness}" />
  </Style>

  <Style Selector="Button.fsus-title-bar-window-action.fsus-title-bar-close:pointerover">
    <Setter Property="Background" Value="{DynamicResource FsusThemeDangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
</Styles>
