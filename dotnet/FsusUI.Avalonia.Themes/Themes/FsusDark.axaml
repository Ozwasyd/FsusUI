<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="FsusThemeBackgroundBrush" Color="#111827" />
  <SolidColorBrush x:Key="FsusThemeSurfaceBrush" Color="#171F2C" />
  <SolidColorBrush x:Key="FsusThemeSurfaceRaisedBrush" Color="#1F2937" />
  <SolidColorBrush x:Key="FsusThemePickerSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeDateTimeSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeValuePickerTrackBrush" Color="#243043" />
  <SolidColorBrush x:Key="FsusThemeUploadSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeDataDisplaySurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeMediaSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeDataTableSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeVirtualizationSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeTreeSurfaceBrush" Color="#1B2433" />
  <SolidColorBrush x:Key="FsusThemeTextBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="FsusThemeMutedTextBrush" Color="#B6C0CF" />
  <SolidColorBrush x:Key="FsusThemeBorderBrush" Color="#394657" />
  <SolidColorBrush x:Key="FsusThemeFocusBrush" Color="#7EA6DA" />
  <SolidColorBrush x:Key="FsusThemeDangerBrush" Color="#F97066" />
  <SolidColorBrush x:Key="FsusThemeDisabledSurfaceBrush" Color="#202A38" />
  <SolidColorBrush x:Key="FsusThemeLoadingBrush" Color="#243043" />
  <x:Double x:Key="FsusThemeDisabledOpacity">0.5</x:Double>
  <x:Double x:Key="FsusThemeFocusThickness">2</x:Double>
</ResourceDictionary>
