<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="FsusThemeBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeSurfaceRaisedBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="FsusThemePickerSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeDateTimeSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeValuePickerTrackBrush" Color="#EEF3FA" />
  <SolidColorBrush x:Key="FsusThemeUploadSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeDataDisplaySurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeMediaSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeDataTableSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeVirtualizationSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeTreeSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeTextViewerSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeTextEditorSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FsusThemeTextBrush" Color="#111827" />
  <SolidColorBrush x:Key="FsusThemeMutedTextBrush" Color="#6B7280" />
  <SolidColorBrush x:Key="FsusThemeBorderBrush" Color="#D9DEE8" />
  <SolidColorBrush x:Key="FsusThemeFocusBrush" Color="#2A599C" />
  <SolidColorBrush x:Key="FsusThemeDangerBrush" Color="#D92D20" />
  <SolidColorBrush x:Key="FsusThemeDisabledSurfaceBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="FsusThemeLoadingBrush" Color="#E8EEF7" />
  <x:Double x:Key="FsusThemeDisabledOpacity">0.46</x:Double>
  <x:Double x:Key="FsusThemeFocusThickness">2</x:Double>
</ResourceDictionary>
