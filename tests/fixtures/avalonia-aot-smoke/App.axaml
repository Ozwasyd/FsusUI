<Application
  x:Class="SmokeApplication"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FsusUI.Avalonia.Themes/Generated/FsusTokens.axaml" />
        <ResourceInclude Source="avares://FsusUI.Avalonia.Themes/Themes/FsusLight.axaml" />
        <ResourceInclude Source="avares://FsusUI.Avalonia.Themes/Themes/FsusDensityDefault.axaml" />
        <ResourceInclude Source="avares://FsusUI.Avalonia.Themes/Themes/FsusMotionSystem.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://FsusUI.Avalonia.Themes/Themes/Controls/MarkdownEditor.axaml" />
  </Application.Styles>
</Application>
