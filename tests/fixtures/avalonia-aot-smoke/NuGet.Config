<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="fsusui-local" value="../../../dotnet/artifacts/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="fsusui-local">
      <package pattern="FsusUI.Avalonia*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
