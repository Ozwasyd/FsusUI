{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": [
      "ES2022",
      "ES2022.Array",
      "ES2022.Error",
      "ES2022.Object",
      "ES2022.String",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "types": [],
    "composite": false,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "declaration": false
  },
  "vueCompilerOptions": {
    "target": 3.5,
    "strictTemplates": true
  },
  "include": [
    "packages",
    "typings/components.d.ts",
    "typings/env.d.ts",
    "typings/vite-worker.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/__tests__/**/*",
    "**/gulpfile.ts",
    "**/test-helper",
    "packages/test-utils",
    "**/*.md",
    "packages/components/*/style/**",
    "packages/components/*/styles/**"
  ]
}
