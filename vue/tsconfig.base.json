{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "sourceMap": false,
    "useDefineForClassFields": true,
    "allowJs": false,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "rootDir": ".",
    "types": [],
    "paths": {
      "@element-plus/icons-vue": ["./packages/icons-vue/src/index.ts"],
      "@element-plus/icons-vue/*": ["./packages/icons-vue/src/*"],
      "@element-plus/*": ["./packages/*"]
    }
  }
}
