{
  "name": "element-plus",
  "version": "1.5.1",
  "description": "A Component Library for Vue 3",
  "keywords": [
    "element-plus",
    "element",
    "component library",
    "ui framework",
    "ui",
    "vue"
  ],
  "homepage": "https://github.com/Ozwasyd/FsusUI",
  "bugs": {
    "url": "https://github.com/Ozwasyd/FsusUI/issues"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "module": "es/index.mjs",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.js"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./es": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./render-pipeline": {
      "types": "./es/render-pipeline.d.ts",
      "import": "./es/render-pipeline.mjs",
      "require": "./lib/render-pipeline.js"
    },
    "./result": {
      "types": "./es/result.d.ts",
      "import": "./es/result.mjs",
      "require": "./lib/result.js"
    },
    "./theme": {
      "types": "./es/theme.d.ts",
      "import": "./es/theme.mjs",
      "require": "./lib/theme.js"
    },
    "./icons-vue": {
      "types": "./es/icons-vue.d.ts",
      "import": "./es/icons-vue.mjs",
      "require": "./lib/icons-vue.js"
    },
    "./wasm": {
      "types": "./es/wasm.d.ts",
      "import": "./es/wasm.mjs",
      "require": "./lib/wasm.js"
    },
    "./markdown-runtime": {
      "types": "./es/markdown-runtime.d.ts",
      "import": "./es/markdown-runtime.mjs",
      "require": "./lib/markdown-runtime.js"
    },
    "./motion": {
      "types": "./es/motion.d.ts",
      "import": "./es/motion.mjs",
      "require": "./lib/motion.js"
    },
    "./perception-challenge": {
      "types": "./es/perception-challenge.d.ts",
      "import": "./es/perception-challenge.mjs",
      "require": "./lib/perception-challenge.js"
    },
    "./dist/public-shell-critical.css": "./dist/public-shell-critical.css",
    "./dist/fsus.css": "./dist/fsus.css",
    "./dist/el-fsus-theme.css": "./dist/el-fsus-theme.css",
    "./dist/index.css": "./dist/index.css",
    "./theme-chalk/*": "./theme-chalk/*",
    "./es/index": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs"
    },
    "./lib/index": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./es/icons-vue": {
      "types": "./es/icons-vue.d.ts",
      "import": "./es/icons-vue.mjs"
    },
    "./lib/icons-vue": {
      "types": "./lib/icons-vue.d.ts",
      "require": "./lib/icons-vue.js"
    },
    "./es/wasm": {
      "types": "./es/wasm.d.ts",
      "import": "./es/wasm.mjs"
    },
    "./lib/wasm": {
      "types": "./lib/wasm.d.ts",
      "require": "./lib/wasm.js"
    },
    "./es/wasm/*": null,
    "./lib/wasm/*": null,
    "./es/components": {
      "types": "./es/components/index.d.ts",
      "import": "./es/components/index.mjs"
    },
    "./es/components/*": {
      "types": [
        "./es/components/*.d.ts",
        "./es/components/*/index.d.ts"
      ],
      "import": "./es/components/*.mjs"
    },
    "./es/components/*.mjs": {
      "types": "./es/components/*.d.ts",
      "import": "./es/components/*.mjs"
    },
    "./lib/components": {
      "types": "./lib/components/index.d.ts",
      "require": "./lib/components/index.js"
    },
    "./lib/components/*": {
      "types": [
        "./lib/components/*.d.ts",
        "./lib/components/*/index.d.ts"
      ],
      "require": "./lib/components/*.js"
    },
    "./lib/components/*.js": {
      "types": "./lib/components/*.d.ts",
      "require": "./lib/components/*.js"
    },
    "./es/constants": {
      "types": "./es/constants/index.d.ts",
      "import": "./es/constants/index.mjs"
    },
    "./es/constants/*": {
      "types": [
        "./es/constants/*.d.ts",
