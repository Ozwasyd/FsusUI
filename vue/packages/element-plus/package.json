      ],
      "import": "./es/constants/*.mjs"
    },
    "./es/constants/*.mjs": {
      "types": "./es/constants/*.d.ts",
      "import": "./es/constants/*.mjs"
    },
    "./lib/constants": {
      "types": "./lib/constants/index.d.ts",
      "require": "./lib/constants/index.js"
    },
    "./lib/constants/*": {
      "types": [
        "./lib/constants/*.d.ts",
        "./lib/constants/*/index.d.ts"
      ],
      "require": "./lib/constants/*.js"
    },
    "./lib/constants/*.js": {
      "types": "./lib/constants/*.d.ts",
      "require": "./lib/constants/*.js"
    },
    "./es/directives": {
      "types": "./es/directives/index.d.ts",
      "import": "./es/directives/index.mjs"
    },
    "./es/directives/*": {
      "types": [
        "./es/directives/*.d.ts",
        "./es/directives/*/index.d.ts"
      ],
      "import": "./es/directives/*.mjs"
    },
    "./es/directives/*.mjs": {
      "types": "./es/directives/*.d.ts",
      "import": "./es/directives/*.mjs"
    },
    "./lib/directives": {
      "types": "./lib/directives/index.d.ts",
      "require": "./lib/directives/index.js"
    },
    "./lib/directives/*": {
      "types": [
        "./lib/directives/*.d.ts",
        "./lib/directives/*/index.d.ts"
      ],
      "require": "./lib/directives/*.js"
    },
    "./lib/directives/*.js": {
      "types": "./lib/directives/*.d.ts",
      "require": "./lib/directives/*.js"
    },
    "./es/hooks": {
      "types": "./es/hooks/index.d.ts",
      "import": "./es/hooks/index.mjs"
    },
    "./es/hooks/*": {
      "types": [
        "./es/hooks/*.d.ts",
        "./es/hooks/*/index.d.ts"
      ],
      "import": "./es/hooks/*.mjs"
    },
    "./es/hooks/*.mjs": {
      "types": "./es/hooks/*.d.ts",
      "import": "./es/hooks/*.mjs"
    },
    "./lib/hooks": {
      "types": "./lib/hooks/index.d.ts",
      "require": "./lib/hooks/index.js"
    },
    "./lib/hooks/*": {
      "types": [
        "./lib/hooks/*.d.ts",
        "./lib/hooks/*/index.d.ts"
      ],
      "require": "./lib/hooks/*.js"
    },
    "./lib/hooks/*.js": {
      "types": "./lib/hooks/*.d.ts",
      "require": "./lib/hooks/*.js"
    },
    "./es/locale": {
      "types": "./es/locale/index.d.ts",
      "import": "./es/locale/index.mjs"
    },
    "./es/locale/*": {
      "types": [
        "./es/locale/*.d.ts",
        "./es/locale/*/index.d.ts"
      ],
      "import": "./es/locale/*.mjs"
    },
    "./es/locale/*.mjs": {
      "types": "./es/locale/*.d.ts",
      "import": "./es/locale/*.mjs"
    },
    "./lib/locale": {
      "types": "./lib/locale/index.d.ts",
      "require": "./lib/locale/index.js"
    },
    "./lib/locale/*": {
      "types": [
        "./lib/locale/*.d.ts",
        "./lib/locale/*/index.d.ts"
      ],
      "require": "./lib/locale/*.js"
    },
    "./lib/locale/*.js": {
      "types": "./lib/locale/*.d.ts",
      "require": "./lib/locale/*.js"
    },
    "./es/motion": {
      "types": "./es/motion.d.ts",
      "import": "./es/motion.mjs"
    },
    "./es/motion/*": {
      "types": [
        "./es/motion/*.d.ts",
        "./es/motion/*/index.d.ts"
      ],
      "import": "./es/motion/*.mjs"
    },
    "./es/motion/*.mjs": {
      "types": "./es/motion/*.d.ts",
      "import": "./es/motion/*.mjs"
    },
    "./lib/motion": {
      "types": "./lib/motion.d.ts",
      "require": "./lib/motion.js"
    },
    "./lib/motion/*": {
      "types": [
        "./lib/motion/*.d.ts",
        "./lib/motion/*/index.d.ts"
      ],
      "require": "./lib/motion/*.js"
    },
    "./lib/motion/*.js": {
      "types": "./lib/motion/*.d.ts",
      "require": "./lib/motion/*.js"
    },
    "./es/utils": {
      "types": "./es/utils/index.d.ts",
      "import": "./es/utils/index.mjs"
    },
    "./es/utils/*": {
      "types": [
        "./es/utils/*.d.ts",
        "./es/utils/*/index.d.ts"
      ],
      "import": "./es/utils/*.mjs"
    },
    "./es/utils/*.mjs": {
      "types": "./es/utils/*.d.ts",
      "import": "./es/utils/*.mjs"
    },
    "./lib/utils": {
      "types": "./lib/utils/index.d.ts",
      "require": "./lib/utils/index.js"
    },
    "./lib/utils/*": {
      "types": [
        "./lib/utils/*.d.ts",
        "./lib/utils/*/index.d.ts"
      ],
      "require": "./lib/utils/*.js"
    },
    "./lib/utils/*.js": {
      "types": "./lib/utils/*.d.ts",
      "require": "./lib/utils/*.js"
    }
  },
  "unpkg": "dist/index.full.js",
  "jsdelivr": "dist/index.full.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ozwasyd/FsusUI.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "style": "dist/fsus.css",
  "sideEffects": [
    "dist/*",
    "theme-chalk/**/*.css",
    "theme-chalk/src/**/*.scss",
    "es/components/*/style/*",
    "lib/components/*/style/*"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^3.4.1",
    "@element-plus/icons-vue": "workspace:*",
    "@element-plus/motion": "workspace:*",
    "@floating-ui/dom": "^1.0.1",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@types/lodash": "^4.14.182",
    "@types/lodash-es": "^4.17.6",
    "async-validator": "^4.2.5",
    "dayjs": "^1.11.3",
    "escape-html": "^1.0.3",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.2",
    "memoize-one": "^6.0.0",
    "mermaid": "^11.15.0",
    "motion-dom": "^12.40.0",
    "normalize-wheel-es": "^1.2.0",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "csstype": "3.2.3",
    "vue": "3.5.32",
    "vue-router": "4.6.4"
  },
  "vetur": {
    "tags": "tags.json",
    "attributes": "attributes.json"
  },
  "web-types": "web-types.json",
  "browserslist": [
    "> 1%",
    "not ie 11",
    "not op_mini all"
  ]
}
