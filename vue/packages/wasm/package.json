{
  "name": "@fsusui/wasm",
  "version": "2.0.0-preview.2",
  "private": true,
  "type": "module",
  "description": "WebAssembly acceleration layer for FsusUI (C++23 / Emscripten)",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": "./*.ts"
  },
  "sideEffects": false,
  "peerDependencies": {
    "katex": "^0.17.0",
    "mermaid": "^11.0.0",
    "shiki": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "katex": { "optional": true },
    "mermaid": { "optional": true },
    "shiki": { "optional": true }
  },
  "dependencies": {
    "@fsusui/core": "workspace:*"
  },
  "scripts": {
    "build:wasm": "node ../../../scripts/with-node-heap.mjs node ../../../scripts/run-wasm-build.mjs",
    "build": "node ../../../scripts/with-node-heap.mjs unbuild",
    "dev": "pnpm run stub",
    "stub": "node ../../../scripts/with-node-heap.mjs unbuild --stub",
    "clean": "rimraf dist build"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "unbuild": "3.6.1"
  }
}
