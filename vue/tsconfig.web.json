{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": [
      "ES2022",
      "ES2022.Array",
      "ES2022.Error",
      "ES2022.Object",
      "ES2022.String",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "types": [],
    "composite": false,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "declaration": false
  },
  "vueCompilerOptions": {
    "target": 3.5,
    "strictTemplates": true,
    "fallthroughAttributes": true,
    "dataAttributes": ["data-*"]
  },
  "include": [
    "packages/core/src",
    "packages/icons/src",
    "packages/motion/src",
    "packages/components/src",
    "packages/fsusui/src",
    "typings/env.d.ts",
    "typings/vite-worker.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/__tests__/**/*",
    "packages/components/src/_native-pending/**/*",
    "packages/test-utils",
    "**/*.md"
  ]
}
