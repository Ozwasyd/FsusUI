{
  "name": "@element-plus/metadata",
  "version": "0.0.1",
  "description": "Metadata for Element Plus",
  "keywords": [
    "element-plus"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/with-node-heap.mjs run-p \"build:*\"",
    "build:contributor": "node ../../../scripts/with-node-heap.mjs tsx src/contributor.ts",
    "build:components": "node ../../../scripts/with-node-heap.mjs tsx src/components.ts",
    "dev": "DEV=1 pnpm run build"
  },
  "devDependencies": {
    "@element-plus/build": "workspace:^0.0.1",
    "@element-plus/build-constants": "workspace:^0.0.1",
    "@element-plus/build-utils": "workspace:^0.0.1",
    "@types/lodash-es": "4.17.12",
    "chalk": "5.6.2",
    "consola": "3.4.2",
    "fast-glob": "3.3.3",
    "lodash-es": "4.18.1",
    "npm-run-all": "4.1.5",
    "octokit": "2.1.0",
    "tsx": "4.21.0"
  }
}
