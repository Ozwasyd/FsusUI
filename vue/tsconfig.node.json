{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "ESNext"],
    "types": ["node"],
    "skipLibCheck": true,
    "rootDir": ".."
  },
  "include": [
    "internal/**/*",
    "internal/**/*.json",
    "../scripts/**/*",
    "packages/wasm/build.config.ts",
    "packages/theme-chalk/*",
    "packages/element-plus/version.ts",
    "packages/element-plus/package.json"
  ],
  "exclude": ["**/__tests__/**", "**/tests/**", "**/dist"]
}
