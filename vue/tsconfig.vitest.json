{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "lib": [
      "ES2022",
      "ES2022.Array",
      "ES2022.Error",
      "ES2022.Object",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node", "jsdom"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false
  },
  "include": [
    "packages/core/src",
    "packages/icons/src",
    "packages/motion/src",
    "packages/components/src",
    "packages/fsusui/src",
    "packages/markdown/src/__tests__",
    "packages/wasm/__tests__",
    "vitest.setup.ts",
    "typings/components.d.ts",
    "typings/env.d.ts",
    "typings/vite-worker.d.ts",
    "typings/vue-test-utils.d.ts",
    "typings/vitest-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/*.md",
    "packages/components/src/_native-pending/**/*"
  ]
}
